name = "CYang-dep/regomoon"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/CYang-dep/regomoon"

license = "Apache-2.0"

description = "A Rego policy-language engine in MoonBit: lexer, parser, and evaluator for .rego modules over JSON documents, with a builtin library and set-of-bindings query semantics."

keywords = [
  "rego",
  "opa",
  "policy",
  "policy-language",
  "declarative",
  "json",
  "moonbit",
]

import {
  "moonbitlang/regexp@0.3.5",
}
